# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- offload ---

# el ejemplo SI se versiona: documenta que claves hacen falta, sin valores
!.env.example

# cliente generado por Prisma (se regenera con `npm run db:generate`)
/src/generated

# artefactos del CLI de Mastra
/.mastra

# material interno del equipo. Este repositorio es el publico de la hackaton:
# aqui viaja solo lo ya destilado, nunca el brief ni los zips de referencia.
/docs-internos

# datos locales de Docker por si alguien monta el volumen en el repo
/docker/data

# el banco de pruebas es un paquete npm aparte, con sus propias dependencias
/bench/node_modules

# --- la voz de una persona no se versiona ---
# Los audios del banco son voz humana real, o sea un dato personal. Viven en
# /docs-internos, que ya esta ignorado; estos globs cubren el dia que alguien
# deje un clip suelto en otra carpeta por comodidad. Al repositorio viaja la
# transcripcion, que es texto.
*.m4a
*.wav
*.webm

# --- credenciales en forma de archivo ---
# La clave privada de Vonage se descarga como archivo .key y acaba, por
# defecto, en la carpeta del proyecto. El repositorio es publico: un .key
# commiteado queda en el historial para siempre y hay que rotar la clave.
*.key
*.pem
private.key
