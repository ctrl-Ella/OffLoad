# Copy this file to `.env` and fill in the values. `.env` never reaches the
# repository, which is public. What travels here are the names.

# --- Local database (docker compose up -d) ----------------------------------
POSTGRES_USER="offload"
POSTGRES_PASSWORD=""
POSTGRES_DB="offload"

# Port 5434 is the one docker-compose.yml publishes.
# `?schema=public` is not optional: Mastra owns its own schema.
# On Railway it is referenced, never copied: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://offload:password@localhost:5434/offload?schema=public"

# --- The public URL of the application --------------------------------------
# Google's redirect URIs and the Vonage and Make webhooks are derived from this.
# Silent auth needs it reachable from a phone over mobile data, so localhost
# does not work: it takes the public tunnel or the deployment.
PUBLIC_URL="http://localhost:3000"

# --- Google: the core circle's calendar and tasks ---------------------------
# Register <PUBLIC_URL>/api/auth/callback/google as an authorised redirect URI.
# The local and Railway ones coexist: deploying adds, it does not replace.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Vonage ------------------------------------------------------------------
# Several applications, each with its own id and its own .key, none of them
# interchangeable. Every variable says which one it belongs to.
#
# No API key and secret anywhere: they authenticate with a signed JWT.
# A private key downloads once, when the application is created. Generating a
# new one in the panel invalidates the previous one.

# --- Vonage · VERIFY: silent verification, the phone sign-in -----------------
VONAGE_VERIFY_APPLICATION_ID=""
VONAGE_VERIFY_PRIVATE_KEY_PATH="./verify.key"

# Regional endpoint, and the name on the fallback SMS. Verify's, both of them.
VONAGE_API_BASE="https://api-eu.vonage.com"
VONAGE_BRAND_NAME="OFFLOAD"

# --- Vonage · VIDEO: the room where a clash gets talked through --------------
VONAGE_VIDEO_APPLICATION_ID=""
VONAGE_VIDEO_PRIVATE_KEY_PATH="./video.key"
# `api.opentok.com` is the previous generation and answers 403 to an
# application JWT.
VONAGE_VIDEO_BASE="https://video.api.vonage.com"

# On Railway there is no key file, so it travels as content. It wins over the
# path and never touches disk: video tokens are signed from the content.
VONAGE_VIDEO_PRIVATE_KEY=""

# --- Vonage · VOICE: the number Nicolás's SIP leg comes in on ----------------
# Doubles today as the SMS sender when Mia invites the support network — a
# real Vonage virtual number, not a second one, since one number carries both
# capabilities. When the SIP bridge is built it gets its own VONAGE_VOICE_*
# pair rather than borrowing video's.
VONAGE_NUMBER=""

# --- Vonage · SMS: inviting the support network into a call ------------------
# Classic API key and secret over Basic auth — checked against the Vonage
# documentation MCP on 2026-09-20: the SMS API has no JWT-authenticated form,
# unlike everything else here. From the account's API settings, not from an
# application. (Not the same pair spec 0008 found unused on Railway: those
# were never validated as still holding the right values, so this is a fresh,
# explicitly named pair.)
VONAGE_SMS_API_KEY=""
VONAGE_SMS_API_SECRET=""

# Same for verification, and base64 is the safer form: Railway's CLI truncated
# the escaped-newline version at the first \n, storing 28 characters of 1703
# and reporting success. Both are accepted.
#   base64 -w0 verify.key
VONAGE_VERIFY_PRIVATE_KEY=""

# --- Nebius: the two model tiers --------------------------------------------
NEBIUS_API_KEY=""

# Small tier: cheap extraction, not the negotiator's own reasoning. Used by
# /api/structure-plan to pull events and tasks out of a transcript.
# No default in code on purpose — a hardcoded fallback model id already went
# stale once when Nebius retired it without redirecting traffic. Checked
# against the live catalog on 2026-09-19
# (`curl -H "Authorization: Bearer $NEBIUS_API_KEY" https://api.tokenfactory.nebius.com/v1/models`)
# and measured for structured JSON output against three candidates the same
# day: fastest and most reliable at resolving relative dates was this one.
NEBIUS_MODEL_SMALL="Qwen/Qwen3-30B-A3B-Instruct-2507"

# Large tier: the negotiator, which chooses whom to ask and writes the
# proposal. Same rule: no default in code, checked against the live catalog.
NEBIUS_MODEL_LARGE="deepseek-ai/DeepSeek-V4-Pro"

# Two base URLs circulate in Nebius's documentation depending on its age;
# this is the one that answers to a current key.
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1"

# --- SLNG: what Mia says and hears outside the call -------------------------
# Sign up at app.slng.ai. The key is generated PER PROJECT — Projects, New
# project, Generate key — and shown once.
SLNG_API_KEY=""

# Mia's voice is Catalina, "Neighborly Guide", chosen on 2026-09-18 by
# listening to four voices in a row: the everyday one won over the three
# described as professional, which sounded like a switchboard. The model is
# the fastest Spanish one served from an EU region, and it is WebSocket only:
# it is for the voice streaming inside the call, and it cannot be asked for
# a clip with a fetch. The identifier is from the Sonic 3 catalogue and the
# model is Sonic 3.5, which publishes no list: unverified until the first
# real call. The live catalogue answers without a key:
#   curl "https://api.slng.ai/v1/catalog/models?service_type=tts&language=es"
SLNG_TTS_MODEL="cartesia/sonic:3.5"
SLNG_TTS_VOICE="162e0f37-8504-474c-bb33-c606c01890dc"

# The stand-in for a whole clip over HTTP, which is what speaks today. Silvia
# was chosen by pace among the sixteen Spanish voices of Aura 2: the same
# sentence in 2.5 s where another took 3.6. On this route the `model` field
# in the body is the voice, and the model goes in the URL. All four defaults
# live in the code: they are a decision, not a secret.
SLNG_TTS_CLIP_MODEL="deepgram/aura:2"
SLNG_TTS_CLIP_VOICE="aura-2-silvia-es"

# Where a family's audio travels. `eu-west`, not `eu-central`: that region
# does not exist in SLNG. The other European one is `eu-north`, and not
# every model reaches both.
SLNG_REGION="eu-west"

# --- The application's own secrets ------------------------------------------
# 32 characters or more, yours to choose. Without it, storing the digest of a
# Spanish mobile number is as good as storing the number.
VERIFICATION_PEPPER=""

# Signs a guest's one-time link into a call. 32 characters or more, yours to
# choose, and a different value from VERIFICATION_PEPPER: the two protect
# different things and reusing one for the other is a coupling nobody asked for.
GUEST_LINK_SECRET=""

# --- Demo data --------------------------------------------------------------
# Here and not in a seed file: the repository is public.
# Numbers starting with 990 belong to the Network Registry Playground.
# The core circle: a line to verify and the Google address to match on sign-in.
TEST_PHONE_ELVIA=""
TEST_PHONE_CARLOS=""
TEST_EMAIL_ELVIA=""
TEST_EMAIL_CARLOS=""

# The support network. A number each and nothing else: Mia sees no calendar of
# theirs and never says they are free. Without these three rows in `people`,
# she never asks whether to call anyone.
TEST_PHONE_NICOLAS=""
TEST_PHONE_ROSA=""
TEST_PHONE_MARTA=""
