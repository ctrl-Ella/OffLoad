# Copy this file to `.env` and fill in the values. `.env` never reaches the
# repository, which is public. What travels here are the names.

# --- Database ---------------------------------------------------------------
# `?schema=public` is not optional: Mastra owns its own schema.
# On Railway it is referenced, never copied: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/offload?schema=public"

# --- The public URL of the application --------------------------------------
# Google's redirect URIs and the Vonage and Make webhooks are derived from this.
PUBLIC_URL="http://localhost:3000"

# --- Google: the core circle's calendar and tasks ---------------------------
# Register <PUBLIC_URL>/api/auth/google/callback as an authorised redirect URI.
# The local and Railway ones coexist: deploying adds, it does not replace.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Vonage: the video call and the SIP bridge ------------------------------
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_APPLICATION_ID=""
VONAGE_NUMBER=""
VONAGE_BRAND_NAME=""
VONAGE_API_BASE=""
# A path locally, because the SDK wants one. On Railway the key travels as
# content in VONAGE_PRIVATE_KEY, newlines escaped, written to /tmp at start-up.
VONAGE_PRIVATE_KEY_PATH="./private.key"

# --- Vonage: silent verification --------------------------------------------
# A different Vonage application: silent auth already works against this one.
VONAGE_VERIFY_API_KEY=""
VONAGE_VERIFY_API_SECRET=""

# --- Nebius: the two model tiers --------------------------------------------
NEBIUS_API_KEY=""

# --- SLNG: what Mia says and hears outside the call -------------------------
SLNG_API_KEY=""

# --- The application's own secrets ------------------------------------------
# Changing the pepper invalidates every stored phone digest.
VERIFICATION_PEPPER=""

# --- Demo data --------------------------------------------------------------
# Here and not in a seed file: the repository is public.
TEST_PHONE_ELVIA=""
TEST_PHONE_CARLOS=""
