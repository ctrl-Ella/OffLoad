# Copy this file to `.env` and fill in the values.
#
# `.env` is in .gitignore and never reaches the repository, which is public.
# What travels here are the variable names and a hint of what goes in each one:
# if someone clones the project, this is what tells them what to ask for.

# --- Database ---------------------------------------------------------------
# The Prisma CLI reads it from prisma.config.ts and the application receives it
# through its driver adapter. `?schema=public` is not optional: Mastra keeps its
# own tables in its own schema, and the schema here governs `public` alone.
#
# Locally, a Postgres in Docker or the Railway one through a TCP proxy.
# On Railway it is referenced, never copied: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/offload?schema=public"

# --- The public URL of the application --------------------------------------
# Google's redirect URIs and the Vonage and Make webhooks are all derived from
# this. Moving from the local tunnel to the Railway domain is a change here, and
# that is the moment to reconfigure the three panels.
PUBLIC_URL="http://localhost:3000"

# --- Google: the core circle's calendar and tasks ---------------------------
# A web application OAuth client in Google Cloud Console.
#
# The redirect URI to register there is derived from PUBLIC_URL:
#   <PUBLIC_URL>/api/auth/google/callback
# Local and Railway URIs coexist, so deploying means adding the new one without
# removing the old.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Vonage: the video call, the SIP bridge and silent verification ---------
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_APPLICATION_ID=""
VONAGE_NUMBER=""
VONAGE_BRAND_NAME=""
VONAGE_API_BASE=""

# Locally this is the path to the file downloaded from the panel, because the
# SDK wants a path. On Railway the key travels as content in VONAGE_PRIVATE_KEY
# with escaped newlines, and the process writes it to /tmp on startup.
# The .key file never enters git: if it ever appears committed, the key is burnt
# even after the file is deleted, and it has to be rotated.
VONAGE_PRIVATE_KEY_PATH="./private.key"

# --- Nebius: the two model tiers --------------------------------------------
# Model identifiers come from the environment and not from the code: Nebius
# retires checkpoints without redirecting traffic, and an identifier written
# into a source file is an outage that shows up with nobody having touched
# anything.
NEBIUS_API_KEY=""

# --- SLNG: what Mia says and hears outside the call -------------------------
SLNG_API_KEY=""

# --- The application's own secrets ------------------------------------------
# The secret pepper used to hash phone numbers. Changing it invalidates every
# stored digest, so treat it as a value that is not regenerated lightly.
VERIFICATION_PEPPER=""
