// Prisma schema. It governs the `public` schema of Postgres and nothing else.
// Mastra creates and maintains its own tables in the `mastra` schema, so they
// are not declared here, and that is why the connection URL ends in
// ?schema=public.

generator client {
  // Prisma 7 replaces `prisma-client-js` with `prisma-client`, which emits
  // plain TypeScript into a project folder instead of into node_modules.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // package.json does not declare "type": "module", so the client is CJS.
  moduleFormat = "cjs"
}

datasource db {
  // In Prisma 7 the URL no longer lives here: migrations read it from
  // prisma.config.ts and the client receives it through the driver adapter.
  provider = "postgresql"
}

/// PROVISIONAL: it exists only to prove the whole circuit works
/// (migration -> client -> query -> page).
/// It gets replaced by the real entities once the domain is settled.
model Note {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notes")
}

/// The two circles of the product, and the difference is structural.
///
/// The CORE connects their Google and Mia sees their whole calendar. SUPPORT
/// only exists in the contact list: Mia sees nothing of theirs and never states
/// their availability. That is why this is an enum and not a boolean with a
/// flag-like name: they are two different things, not a permission toggled on
/// and off.
enum Circle {
  CORE
  SUPPORT
}

/// Who each person is. Everything else hangs off this entity.
///
/// The phone number is not stored in the clear: `phoneHash` holds the digest
/// computed with the secret pepper from the environment, and `phoneTail` the
/// last digits, so the app can show which number it is without revealing it.
/// The name is stored as given, because it is what Mia says out loud.
///
/// There is no open sign-up: a person exists because the family added them, not
/// because someone verified a phone. Verifying proves the line is yours, not
/// that you belong to this household.
model Person {
  id        String   @id @default(cuid())
  name      String
  circle    Circle
  phoneHash String   @unique @map("phone_hash")
  phoneTail String   @map("phone_tail")
  /// The Google address, when there is one. It is the second way in.
  ///
  /// Optional on purpose: the support network has no account, and someone in
  /// the core can exist with only a phone number until they connect Google.
  ///
  /// Unlike the phone, this is NOT hashed: the address has to be compared with
  /// whatever Google returns on every sign-in, and a salted digest cannot be
  /// compared against incoming data without recomputing it. It is personal
  /// data, so it never appears in a log.
  email     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")

  verifications Verification[]
  sessions      Session[]
  googleAccount GoogleAccount?
  captures      Capture[]

  @@map("people")
}

/// The permission someone in the core has granted Mia over their Google.
///
/// It lives apart from `Person` because it has a different reason to change:
/// the person is still the same person after revoking, and revoking is deleting
/// this row and nothing else.
///
/// **Deliberate technical debt:** `refreshToken` is stored in the clear.
/// Encrypting it at rest is the right thing and there is no time for it this
/// weekend; it is written down here rather than left in a conversation. This
/// token opens someone's calendar until they revoke it, which makes the
/// production database sensitive material.
model GoogleAccount {
  id           String   @id @default(cuid())
  personId     String   @unique @map("person_id")
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  email        String
  refreshToken String   @map("refresh_token")
  /// What the person actually granted, which need not be what was asked for:
  /// Google's consent screen lets you untick permissions one by one.
  scope        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("google_accounts")
}

/// Something someone told Mia that is not yet recorded anywhere.
///
/// **It exists because a brain dump you lose is not a brain dump.** Until there
/// was a table, every dictated sentence lived inside its run and the next one
/// covered it: you said two things in a row and the first vanished from the
/// screen without anything being lost, simply because it had never been saved.
///
/// **It is not the same as a calendar event, which is why it does not live
/// there.** A capture is what Mia understood; an event is what someone
/// confirmed. Rule 1 of the project is exactly that boundary: nothing is
/// written to a calendar without a human yes. `googleEventId` gets filled in
/// when that yes arrives, and while it is empty the interface says this is not
/// on any calendar — because it is not.
///
/// It is called `Capture` and not `Note` because `Note` is taken by the
/// provisional table, and because capture describes it better: what was picked
/// up, before anyone confirmed it.
model Capture {
  id            String    @id @default(cuid())
  personId      String    @map("person_id")
  person        Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// One of the interpreter's seven labels: stop, reminder, note, delegate,
  /// move, question, shopping.
  kind          String
  title         String
  /// When it starts, if a time was said. Null for everything without one, which
  /// is most of what gets blurted out in one go.
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  /// The place name exactly as it appears in the places table, or null.
  place         String?
  /// The Google event id, once someone has confirmed it should be written.
  /// While this is null, the capture exists on no calendar.
  googleEventId String?   @map("google_event_id")
  /// Which brain dump it came from. It is what lets you follow a whole run when
  /// something looks wrong, and in a demo that is half the debugging.
  runId         String?   @map("run_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([personId])
  @@map("captures")
}

/// An open session: the browser brings the token, the server says whose it is.
///
/// The token is opaque and the server generates it. The person id is NOT stored
/// in the cookie, not even signed: a cookie with an identifier inside invites
/// someone to change it, and the whole application depends on knowing who you
/// are. With an opaque token, impersonating someone means guessing a UUID, and
/// signing out means deleting a row.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  personId  String   @map("person_id")
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([personId])
  @@map("sessions")
}

/// The household's video room. One, and always the same one.
///
/// **It belongs to the household, not to a run.** The clash that leads to a
/// call comes out of someone's day, not out of a live run — the conflict screen
/// reloads without one — so hanging the room off a `runId` would mean inventing
/// where that identifier comes from when someone joins on their own.
///
/// **It exists because a Vonage session has to be remembered.** If a new one
/// were created on every join, Elvia and Carlos would end up in two different
/// rooms, each seeing only themselves. `key` is unique so that this does not
/// depend on nobody making a mistake: there is one row, `"core"`, and it gets
/// reused.
model Room {
  id        String   @id @default(cuid())
  /// Whose room this is. Today there is a single value, `"core"`, and it is the
  /// lock that stops a second one being created.
  key       String   @unique
  sessionId String   @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("rooms")
}

/// A phone number that went through Vonage's silent verification.
///
/// This records an ATTEMPT, not a person. It is kept separate from `Person` on
/// purpose: an attempt can come from a number that belongs to nobody in the
/// household, and that is something you want to be able to see too.
///
/// `personId` is optional for the same reason: it is filled in only when the
/// verified number turns out to belong to someone known.
model Verification {
  id        String   @id @default(cuid())
  phoneHash String   @unique @map("phone_hash")
  phoneTail String   @map("phone_tail")
  requestId String   @unique @map("request_id")
  status    String
  /// Which route completed it: it tells you whether silent auth worked or
  /// whether it fell back to SMS.
  channel   String?
  personId  String?  @map("person_id")
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([personId])
  @@map("verifications")
}
